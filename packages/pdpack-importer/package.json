{
  "name": "pdpack-importer",
  "version": "1.0.0",
  "description": "Custom importer for .pdpack files",
  "author": "",
  "main": "main.js",
  "runtime-resource": {
    "path": "engine",
    "name": "pdpack"
  },
  "main-menu": {
    "Packages/test": {
      "message": "pdpack:test"
    }
  },
  "inspector": {
    "pdpack": "./inspectors/pdpack/main.js"
  },
  "reload": {
    "ignore": [
      "engine/**/*"
    ]
  }
}