{
  "name": "pdpack-importer",
  "version": "1.0.0",
  "description": "Custom importer for .pdpack files",
  "author": "",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "runtime-resource": {
    "path": "runtime-resource/runtime",
    "name": "runtime"
  },
  "inspector": {
    "pdpack": "./dist/src/inspectors/pdpack/main.js"
  },
  "reload": {
    "ignore": [
      "runtime-resource/**/*"
    ]
  }
}
